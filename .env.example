# ==============================================================================
# ASTRAFLAME Production & Security Configuration (.env.example)
# All secret credentials must remain on the backend and never exposed to the client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY DATABASE – Supabase PostgreSQL (Authoritative Writes & Identity)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-primary-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-side exposed variables for Vite (Auth & Storage public access only)
# NEVER put SUPABASE_SERVICE_ROLE_KEY or LLM keys into VITE_ variables!
VITE_SUPABASE_URL=https://your-primary-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase PostgreSQL Connection Strings
# Transaction Pooler (port 6543) for application queries & Prisma:
PRIMARY_DATABASE_URL="postgresql://postgres.your-primary-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Direct Connection (port 5432) for migrations:
PRIMARY_DIRECT_URL="postgresql://postgres:your-db-password@db.your-primary-id.supabase.co:5432/postgres?sslmode=require"

# Legacy aliases
DATABASE_URL="postgresql://postgres.your-primary-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-db-password@db.your-primary-id.supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SECONDARY DATABASE – Analytical PostgreSQL (Heavy Reporting & Aggregations)
# ------------------------------------------------------------------------------
SECONDARY_DATABASE_URL="postgresql://analytics_user:your-analytics-password@your-secondary-host:5432/astraflame_analytics?sslmode=prefer"

# ------------------------------------------------------------------------------
# 3. Security, Authentication & CORS Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Trusted frontend origins (comma-separated, no wildcards with credentials in prod)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Dedicated administrative API key for backend operations & migration runner
ADMIN_API_KEY=your-secure-admin-api-key-here

# ------------------------------------------------------------------------------
# 4. AI Chatbot Configuration (Backend Only)
# ------------------------------------------------------------------------------
# Backend-only LLM credentials (never exposed in client code)
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. Client API Routing
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 6. Synchronization Engine & Performance Cache Settings
# ------------------------------------------------------------------------------
SYNC_INTERVAL_MS=5000
SYNC_BATCH_SIZE=50
SYNC_MAX_RETRIES=3
ANALYTICS_CACHE_TTL_MS=30000
